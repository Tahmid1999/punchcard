# Server-side only. The admin's session token lives in an httpOnly cookie and
# app/api/pc/[...path]/route.ts attaches it before forwarding, so page scripts
# never hold it.
API_URL="http://localhost:3200"

# Goes into the pairing QR, so it is the address the phone uses, not localhost.
# On a LAN demo that is this laptop's IP.
NEXT_PUBLIC_PHONE_API_URL="http://192.168.0.10:3200"

# Times on every page are shown in office time, matching the API's TIMEZONE.
NEXT_PUBLIC_TIMEZONE="Asia/Dhaka"
