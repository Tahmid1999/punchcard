# Copy to .env. Never commit the real file.

DATABASE_URL="postgresql://punchcard:punchcard@localhost:5434/punchcard?schema=public"

# Signs admin session tokens.
JWT_SECRET="dev-secret-change-me"

# Seeded by `npm run seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

PORT=3200

# Office time zone. The month report splits days on this, not on UTC.
TIMEZONE="Asia/Dhaka"

# The Python face service in ../face.
FACE_URL="http://localhost:3201"

# Cosine similarity a check-in face must reach against a reference. 0.363 is the
# value OpenCV publishes for SFace.
FACE_THRESHOLD=0.363
